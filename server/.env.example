NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sahakari_ledger
CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Separate secret used to sign the ledger hash chain (also 32+ random characters)
LEDGER_HMAC_SECRET=

# First administrator, created by `npm run seed` (must change password at first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=ChangeMe-Now-2026!

# Optional SMTP settings. If SMTP_HOST is empty, reset links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sahakari Ledger <no-reply@example.com>"
