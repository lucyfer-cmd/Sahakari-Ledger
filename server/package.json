{
  "name": "sahakari-ledger-server",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for Sahakari Ledger: a tamper-evident savings and loan system for cooperatives",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "seed:demo": "node src/scripts/seed.js --demo",
    "demo:tamper": "node src/scripts/demo-tamper.js tamper",
    "demo:restore": "node src/scripts/demo-tamper.js restore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
